{
  "name": "@devigner-ui/icons-react-native",
  "version": "3.5.0",
  "description": "10,560 open-source icons for React Native: 2,112 symbols, each in outline, twotone, bold, bulk and broken. Built on Solar Icon Set and Iconsax.",
  "keywords": [
    "icons",
    "react-native",
    "expo",
    "react-native-svg",
    "svg",
    "svg-icons",
    "icon-set",
    "icon-library"
  ],
  "license": "MIT AND CC-BY-4.0",
  "author": "Devigner",
  "homepage": "https://icons.devigner.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devigner-ui/icons.git",
    "directory": "packages/icons-react-native"
  },
  "bugs": {
    "url": "https://github.com/devigner-ui/icons/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
