    },
    "./icons/3dcube": "./dist/aliases/3dcube.js",
    "./icons/Additem": "./dist/aliases/Additem.js",
    "./icons/CPU": "./dist/aliases/CPU.js",
    "./icons/CPUBolt": "./dist/aliases/CPUBolt.js",
    "./icons/Convertshape": "./dist/aliases/Convertshape.js",
    "./icons/Firstline": "./dist/aliases/Firstline.js",
    "./icons/GPS": "./dist/aliases/GPS.js",
    "./icons/Happyemoji": "./dist/aliases/Happyemoji.js",
    "./icons/HomeWiFi": "./dist/aliases/HomeWiFi.js",
    "./icons/HomeWiFiAngle": "./dist/aliases/HomeWiFiAngle.js",
    "./icons/Magicpen": "./dist/aliases/Magicpen.js",
    "./icons/Paintbucket": "./dist/aliases/Paintbucket.js",
    "./icons/Personalcard": "./dist/aliases/Personalcard.js",
    "./icons/SIMCard": "./dist/aliases/SIMCard.js",
    "./icons/SIMCards": "./dist/aliases/SIMCards.js",
    "./icons/Screenmirroring": "./dist/aliases/Screenmirroring.js",
    "./icons/Smallcaps": "./dist/aliases/Smallcaps.js",
    "./icons/Stickynote": "./dist/aliases/Stickynote.js",
    "./icons/TextalignCenter": "./dist/aliases/TextalignCenter.js",
    "./icons/TextalignJustifycenter": "./dist/aliases/TextalignJustifycenter.js",
    "./icons/TextalignJustifyleft": "./dist/aliases/TextalignJustifyleft.js",
    "./icons/TextalignJustifyright": "./dist/aliases/TextalignJustifyright.js",
    "./icons/TextalignLeft": "./dist/aliases/TextalignLeft.js",
    "./icons/TextalignRight": "./dist/aliases/TextalignRight.js",
    "./icons/WiFiRouter": "./dist/aliases/WiFiRouter.js",
    "./icons/WiFiRouterRound": "./dist/aliases/WiFiRouterRound.js",
    "./icons/ZIPFile": "./dist/aliases/ZIPFile.js",
    "./icons/*": "./dist/icons/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ATTRIBUTION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "@devigner-ui/icons": "workspace:^",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
