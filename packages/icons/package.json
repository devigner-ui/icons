  "files": [
    "bin",
    "dist",
    "ATTRIBUTION.md"
  ],
  "scripts": {
    "import:svgs": "node scripts/import-svgs.mjs",
    "import:broken": "node scripts/import-broken.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:watch": "node scripts/sync.mjs --watch",
    "deduplicate": "node scripts/deduplicate.mjs",
    "optimize:paths": "node scripts/optimize-paths.mjs",
    "fix-names": "node scripts/fix-names.mjs",
    "generate:metadata": "node scripts/generate-metadata.mjs",
    "generate:embeddings": "node scripts/generate-embeddings.mjs",
    "build": "pnpm optimize:paths && pnpm sync && pnpm generate:metadata && pnpm generate:embeddings && tsup",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "node scripts/artwork-check.mjs && node scripts/surface-check.mjs && node scripts/render-check.mjs && node scripts/emit-svg.mjs && node scripts/import-check.mjs && node scripts/rename-check.mjs && node scripts/search-check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@xenova/transformers": "^2.17.0",
    "chokidar": "^3.6.0",
    "svgo": "^3.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
