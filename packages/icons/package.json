{
  "name": "@devigner-ui/icons",
  "version": "3.5.0",
  "description": "10,560 open-source icons for React: 2,112 symbols, each in outline, twotone, bold, bulk and broken. Built on Solar Icon Set and Iconsax.",
  "keywords": [
    "icons",
    "react",
    "react-icons",
    "svg",
    "svg-icons",
    "icon-set",
    "icon-library",
    "typescript",
    "tree-shaking",
    "outline-icons"
  ],
  "license": "MIT AND CC-BY-4.0",
  "author": "Devigner",
  "homepage": "https://icons.devigner.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devigner-ui/icons.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/devigner-ui/icons/issues"
  },
  "type": "module",
  "bin": {
    "icons": "./bin/cli.mjs"
  },
