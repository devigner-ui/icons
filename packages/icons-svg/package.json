{
  "name": "@devigner-ui/icons-svg",
  "version": "3.5.0",
  "description": "10,560 raw SVG files for @devigner-ui/icons: 2,112 symbols in outline, twotone, bold, bulk and broken. No framework, no build step, CDN-ready.",
  "keywords": [
    "icons",
    "svg",
    "svg-icons",
    "icon-set",
    "sprite",
    "cdn",
    "vanilla"
  ],
  "license": "MIT AND CC-BY-4.0",
  "author": "Devigner",
  "homepage": "https://icons.devigner.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devigner-ui/icons.git",
    "directory": "packages/icons-svg"
  },
  "bugs": {
    "url": "https://github.com/devigner-ui/icons/issues"
  },
  "type": "module",
  "exports": {
    "./svg/*": "./svg/*",
    "./sprite/*": "./sprite/*",
    "./renames.json": "./renames.json",
    "./package.json": "./package.json"
  },
  "files": [
    "svg",
    "sprite",
    "renames.json",
    "ATTRIBUTION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@devigner-ui/icons": "workspace:^"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
