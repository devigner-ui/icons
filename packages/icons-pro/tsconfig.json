{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    // No ambient globals. This package is browser-targeted (atob and
    // crypto.subtle both come from lib.dom) and compiles src/ only. The
    // ["node"] that used to sit here named a dependency the package never
    // had, which failed the dts build outright.
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}