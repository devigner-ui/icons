{
  "name": "devigner-icons",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:docs": "pnpm --filter=@devigner-ui/icons-docs dev",
    "docs:build": "pnpm --filter=@devigner-ui/icons-docs build",
    "sync": "pnpm --filter=@devigner-ui/icons sync",
    "sync:watch": "pnpm --filter=@devigner-ui/icons sync:watch",
    "fix-names": "pnpm --filter=@devigner-ui/icons fix-names",
    "generate:metadata": "pnpm --filter=@devigner-ui/icons generate:metadata",
    "generate:embeddings": "pnpm --filter=@devigner-ui/icons generate:embeddings",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
