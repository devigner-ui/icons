# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Build outputs
dist/
.turbo/
*.tsbuildinfo

# Generated by scripts/gen-icon-data.mjs, which `dev` and `build` both run.
# svgs/ is ~12 MB of extracted path data and regenerates byte-identically from
# the icon packages, so tracking it puts a fresh set of blobs in history on
# every rebuild. The hand-made assets beside it (og.png, favicons, manifest,
# robots.txt) are source and stay tracked.
public/icons.json
public/embeddings.json
public/svgs/
src/generated/

# Working notes and docs. On disk, not on GitHub.
PRODUCT.md
PLAN.md
DESIGN.md
REDESIGN.md
CHANGELOG.md
docs/

# Where SVGs are dropped for scripts/import-svgs.mjs. A staging area: the
# importer moves what it consumes into incoming/imported/, and the .tsx it
# writes is the tracked copy of the artwork.
packages/icons/incoming/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.temp

# Agent tooling: local to each machine, nothing here is build input.
.claude/
.agents/
.impeccable

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
CLAUDE.md
CLAUDE.md
